# ── Core ──────────────────────────────────────────────────────────────────────
PROJECT_NAME=AI Survey Generator
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production — must be at least 32 random chars
SECRET_KEY=your-secret-key-change-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL=sqlite:///./survey_generator.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@host:5432/survey_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list — no trailing slash
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
CHATGPT_MODEL=gpt-4o
GOOGLE_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash

# ── Prompts path (relative to backend/) ───────────────────────────────────────
PROMPTS_BASE_PATH=prompts/prompts_chatgpt

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Phase 3: Observability ────────────────────────────────────────────────────
# Sentry — leave empty to disable
SENTRY_DSN=

# OpenTelemetry — OTLP gRPC endpoint (e.g. Grafana Tempo, Jaeger)
# Leave empty to disable
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=ai-survey-generator
