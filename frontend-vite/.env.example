# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Environment
VITE_NODE_ENV=development

# Phase 3: Error tracking — leave empty to disable Sentry
VITE_SENTRY_DSN=

# Phase 3: Release tag for Sentry breadcrumbs — set by CI (e.g. git SHA)
VITE_RELEASE=

# Phase 3: Enable verbose HTTP logging in browser console
VITE_DEBUG_HTTP=false
